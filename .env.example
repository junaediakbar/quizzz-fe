# Base URL API backend (tanpa trailing slash). WAJIB diisi — kalau kosong di
# production, build/load gagal dengan pesan error yang jelas
# (lihat src/lib/api/client.ts).
#
# Local development:
#   cp .env.example .env.local
#   NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
#
# Production (Vercel): JANGAN isi di file ini — file .env* tidak ikut ter-deploy.
# Set di Vercel Dashboard → Settings → Environment Variables:
#   key   : NEXT_PUBLIC_API_URL
#   value : https://quiz-api.junaediakbar.web.id/api/v1
#   env   : Production, Preview, dan Development — lalu redeploy.
NEXT_PUBLIC_API_URL=
